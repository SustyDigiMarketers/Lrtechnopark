# =================================================================
# LR TECHNO PARK ENTERPRISE PLATFORM - ENVIRONMENT VARIABLES
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI assistant features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current hosting URL.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-Side)
# -----------------------------------------------------------------
# Base URL for deployed Express API when frontend is on GitHub Pages
VITE_API_BASE_URL=""

# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -----------------------------------------------------------------
# BACKEND CONFIGURATION (Server-Side Secrets - Never in Client)
# -----------------------------------------------------------------
# Server listening port
PORT=3000

# Private KMS signing secret for HMAC-SHA256 license tokens
LICENSE_SIGNING_SECRET=""

# Server authentication token signing secret
AUTH_SECRET=""

# Google Sheets Webhook Integration
GOOGLE_APPS_SCRIPT_URL=""
APPS_SCRIPT_SHARED_SECRET=""
